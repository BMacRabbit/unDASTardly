    {
        "id": "json-parse",
        "type": "json",
        "z": "tab-dast",
        "name": "Parse JSON",
        "action": "obj",
        "pretty": false,
        "x": 370,
        "y": 100,
        "wires": [
            [
                "fn-split"
            ]
        ]
    },
    {
        "id": "fn-split",
        "type": "function",
        "z": "tab-dast",
        "name": "Split telemetry to channels",
        "func": "var p = msg.payload;\nif (typeof p === 'string') {\n    try { p = JSON.parse(p); } catch(e) { return null; }\n}\n\n// Store mode for status\nflow.set('lastMode', p.mode || 'unknown');\nflow.set('lastUptime', p.uptime_s || 0);\nflow.set('jrkOK', p.jrk_ok);\nflow.set('lastRSSI', p.wifi_rssi || 0);\n\nvar send = node.send;\n\n// AZ actual\nsend([{payload: p.az_actual, topic: 'AZ Actual'},\n      {payload: p.el_actual, topic: 'EL Actual'},\n      {payload: p.az_error,  topic: 'AZ Error'},\n      {payload: p.el_error,  topic: 'EL Error'},\n      {payload: p.panel_v,   topic: 'Voltage (V)'},\n      {payload: p.panel_i,   topic: 'Current (A)'},\n      {payload: p.panel_w,   topic: 'Power (W)'},\n      {payload: p.az_cmd,    topic: 'AZ Command'},\n      {payload: p.el_cmd,    topic: 'EL Command'},\n      {payload: p.trk_irrad, topic: 'Irradiance S'},\n      {payload: p.trk_e_az,  topic: 'Track Error AZ'},\n      {payload: p.trk_e_el,  topic: 'Track Error EL'},\n      null,null]);\n\nreturn null;",
        "outputs": 0,
        "x": 580,
        "y": 100,
        "wires": []
    },
    {
        "id": "fn-esp32-status",
        "type": "function",
        "z": "tab-dast",
        "name": "ESP32 online status",
        "func": "var online = (msg.payload === 'online');\nflow.set('esp32online', online);\nmsg.payload = online;\nreturn msg;",
        "outputs": 1,
        "x": 390,
        "y": 160,
        "wires": [
            [
                "tmpl-esp32-led"
            ]
        ]
    },
    {
        "id": "mqtt-in-tel2",
        "type": "mqtt in",
        "z": "tab-dast",
        "name": "Tel for gauges",
        "topic": "dast/telemetry",
        "qos": "0",
        "datatype": "auto",
        "broker": "broker1",
        "inputs": 0,
        "x": 160,
        "y": 240,
        "wires": [
            [
                "fn-to-gauges"
            ]
        ]
    },
    {
        "id": "fn-to-gauges",
        "type": "function",
        "z": "tab-dast",
        "name": "Route to all gauges and charts",
        "func": "var p = msg.payload;\nif (typeof p === 'string') {\n    try { p = JSON.parse(p); } catch(e) { return null; }\n}\n\nreturn [\n    {payload: p.az_actual, topic: 'AZ Actual (deg)'},\n    {payload: p.el_actual, topic: 'EL Actual (deg)'},\n    {payload: p.az_error,  topic: 'AZ Error (deg)'},\n    {payload: p.el_error,  topic: 'EL Error (deg)'},\n    {payload: p.panel_v,   topic: 'Voltage (V)'},\n    {payload: p.panel_i,   topic: 'Current (A)'},\n    {payload: p.panel_w,   topic: 'Power (W)'},\n    {payload: p.az_cmd,    topic: 'AZ Command'},\n    {payload: p.el_cmd,    topic: 'EL Command'},\n    {payload: p.trk_irrad, topic: 'Irradiance S'},\n    {payload: (p.mode || 'unknown').toUpperCase() + '  |  JRK:' + (p.jrk_ok ? 'OK' : 'FAULT') + '  |  RSSI:' + (p.wifi_rssi || '--') + 'dBm  |  Up:' + Math.floor((p.uptime_s||0)/60) + 'min'},\n    {payload: p.jrk_ok}\n];",
        "outputs": 12,
        "x": 390,
        "y": 440,
        "wires": [
            [
                "gauge-az"
            ],
            [
                "gauge-el"
            ],
            [
                "gauge-az-err",
                "chart-err"
            ],
            [
                "gauge-el-err",
                "chart-err"
            ],
            [
                "gauge-panel-v",
                "chart-panel-v"
            ],
            [
                "gauge-panel-i",
                "chart-panel-i"
            ],
            [
                "gauge-panel-w",
                "chart-panel-w"
            ],
            [
                "chart-az",
                "chart-el"
            ],
            [
                "chart-az",
                "chart-el"
            ],
            [
                "chart-irrad"
            ],
            [
                "txt-status"
            ],
            [
                "tmpl-jrk-led"
            ]
        ]
    },
