        "type": "ui-chart",
        "z": "tab-dast",
        "group": "grp-position-charts",
        "name": "Azimuth chart",
        "label": "Azimuth",
        "order": 1,
        "chartType": "line",
        "category": "topic",
        "categoryType": "msg",
        "xAxisType": "time",
        "ymin": "-90",
        "ymax": "90",
        "bins": 1800,
        "action": "append",
        "showLegend": true,
        "removeOlder": 4,
        "removeOlderUnit": "3600",
        "width": "6",
        "height": "4",
