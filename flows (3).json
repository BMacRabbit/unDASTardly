    {
        "id": "fn-csv-log",
        "type": "function",
        "z": "tab-dast",
        "name": "Format CSV row",
        "func": "var p = msg.payload;\nif (typeof p === 'string') {\n    try { p = JSON.parse(p); } catch(e) { return null; }\n}\nvar now = new Date();\nvar row = [\n    now.toISOString(),\n    p.mode        || '',\n    p.az_cmd      !== undefined ? p.az_cmd      : '',\n    p.az_actual   !== undefined ? p.az_actual   : '',\n    p.az_error    !== undefined ? p.az_error    : '',\n    p.el_cmd      !== undefined ? p.el_cmd      : '',\n    p.el_actual   !== undefined ? p.el_actual   : '',\n    p.el_error    !== undefined ? p.el_error    : '',\n    p.trk_e_az    !== undefined ? p.trk_e_az    : '',\n    p.trk_e_el    !== undefined ? p.trk_e_el    : '',\n    p.trk_irrad   !== undefined ? p.trk_irrad   : '',\n    p.trk_valid   !== undefined ? p.trk_valid   : '',\n    p.trk_state   || '',\n    p.panel_v     !== undefined ? p.panel_v     : '',\n    p.panel_i     !== undefined ? p.panel_i     : '',\n    p.panel_w     !== undefined ? p.panel_w     : '',\n    p.jrk_ok      !== undefined ? p.jrk_ok      : '',\n    p.hw_manual   !== undefined ? p.hw_manual   : '',\n    p.wifi_rssi   !== undefined ? p.wifi_rssi   : '',\n    p.uptime_s    !== undefined ? p.uptime_s    : ''\n].join(',');\nmsg.payload = row + '\\n';\nreturn msg;",
        "outputs": 1,
        "x": 600,
        "y": 960,
        "wires": [
            [
                "file-log"
            ]
        ]
    },
